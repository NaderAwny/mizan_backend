            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"محمد علي\",\n  \"phoneNumber\": \"01012345678\",\n  \"notes\": \"عميل مميز\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts"]
            },
            "description": "إضافة طرف جديد (عميل أو مورد).\n🔒 يتطلب Bearer Token."
          }
        },
        {
          "name": "2 — قائمة الأطراف (List Contacts)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('تم جلب قائمة الأطراف بنجاح', function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
