                  "    var json = pm.response.json();",
                  "    pm.environment.set('contact_id', json.data.id);",
                  "    pm.test('تم إنشاء الطرف بنجاح', function() {",
                  "        pm.expect(json.success).to.be.true;",
                  "        pm.expect(json.data.id).to.be.a('string');",
                  "    });",
