        {
          "name": "3 — طرف بالمعرف (Get Contact by ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('تم جلب بيانات الطرف بنجاح', function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.json().success).to.be.true;",
